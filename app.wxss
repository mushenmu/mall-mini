/**app.wxss - 全局样式**/
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

/* 商品卡片通用 */
.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 16rpx;
}

.goods-card .thumb {
  width: 100%;
  height: 340rpx;
  background: #f0f0f0;
  display: block;
}

.goods-card .info {
  padding: 16rpx 20rpx 20rpx;
}

.goods-card .title {
  font-size: 28rpx;
  line-height: 1.4;
  height: 78rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-card .price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price {
  color: #fa4126;
  font-size: 36rpx;
  font-weight: 600;
}

.price .symbol {
  font-size: 24rpx;
}

.origin-price {
  color: #999;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #fa4126;
  border: 1rpx solid #fa4126;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
}

/* 按钮 */
.btn-primary {
  background: #fa4126;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 20rpx 0;
}

.btn-disabled {
  background: #ccc !important;
  color: #fff !important;
}

/* 空态 */
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 28rpx;
}

/* 网络错误态 */
.error-state { display: flex; flex-direction: column; align-items: center; color: #999; padding: 80rpx 0; }
.retry { color: #fa4126; margin-top: 20rpx; }

/* 底部安全区 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
