.form-card {
  background: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-row:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.region-inputs {
  flex: 1;
  display: flex;
}

.region {
  margin-right: 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.region:last-child {
  margin-right: 0;
}

.textarea {
  flex: 1;
  font-size: 28rpx;
  min-height: 60rpx;
}

.save-btn {
  margin: 40rpx 24rpx;
  background: #fa4126;
  color: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
}
