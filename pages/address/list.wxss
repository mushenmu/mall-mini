.addr-card {
  background: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.addr-head {
  display: flex;
  align-items: center;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
}

.addr-phone {
  color: #666;
  margin-left: 16rpx;
  font-size: 26rpx;
}

.default-tag {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #fa4126;
  border: 1rpx solid #fa4126;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.addr-detail {
  color: #666;
  font-size: 26rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}

.addr-ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.op {
  font-size: 26rpx;
  color: #666;
  margin-left: 32rpx;
  padding: 4rpx 8rpx;
}

.add-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fa4126;
  color: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
}
