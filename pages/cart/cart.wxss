.page {
  padding-bottom: 140rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.check.checked {
  background: #fa4126;
  border-color: #fa4126;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.title {
  font-size: 28rpx;
  line-height: 1.4;
  height: 78rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.price-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.step-btn.disabled {
  color: #ccc;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
}

.delete {
  padding: 16rpx 8rpx 16rpx 16rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}

/* 结算栏 */
.settle-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.check-all {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.total {
  flex: 1;
  text-align: right;
  margin-right: 24rpx;
  font-size: 26rpx;
}

.settle-btn {
  background: #fa4126;
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 24rpx;
  color: #fa4126;
  border: 1rpx solid #fa4126;
  border-radius: 32rpx;
  padding: 12rpx 48rpx;
}
