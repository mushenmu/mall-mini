.gallery {
  width: 100%;
  height: 750rpx;
  background: #f0f0f0;
}

.gallery-img {
  width: 100%;
  height: 750rpx;
}

.panel {
  background: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.sales {
  margin-left: auto;
  color: #999;
  font-size: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 12rpx;
}

.subtitle {
  color: #666;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.tags {
  margin-top: 12rpx;
}

.label {
  font-size: 28rpx;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.step-btn.disabled {
  color: #ccc;
}

.step-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 详情 */
.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.detail-panel rich-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #666;
  margin-right: 24rpx;
}

.cart-icon {
  font-size: 40rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  color: #fff;
  padding: 20rpx 0;
  font-size: 30rpx;
}

.action-btn.add {
  background: #ff9500;
  border-radius: 44rpx 0 0 44rpx;
}

.action-btn.buy {
  background: #fa4126;
  border-radius: 0 44rpx 44rpx 0;
}
