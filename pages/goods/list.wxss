.page {
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  color: #999;
  padding: 0 8rpx;
}

/* 热门词 */
.hot-words {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 8rpx 24rpx 24rpx;
}

.hot-word {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin: 8rpx 16rpx 0 0;
}

/* 分类横向滚动 */
.cate-scroll {
  background: #fff;
  white-space: nowrap;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.cate-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 8rpx;
  font-size: 28rpx;
  color: #333;
  border-radius: 28rpx;
  background: #f5f5f5;
}

.cate-item.active {
  color: #fff;
  background: #fa4126;
}

/* 排序条 */
.sort-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.sort-item {
  margin-right: 48rpx;
  font-size: 28rpx;
  color: #333;
}

.sort-item.active {
  color: #fa4126;
  font-weight: 600;
}

/* 商品行卡片 */
.goods-card.row {
  display: flex;
  padding: 20rpx;
}

.goods-card.row .thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-card.row .info {
  flex: 1;
  padding: 0 0 0 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-card.row .title {
  height: auto;
  -webkit-line-clamp: 2;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}

.tags {
  margin-top: 8rpx;
}

.sales {
  color: #999;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.loading-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}
