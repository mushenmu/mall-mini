<view class="page">
  <!-- 轮播图 -->
  <swiper class="swiper" indicator-dots autoplay circular interval="4000" duration="500"
    wx:if="{{swiper.length}}">
    <swiper-item wx:for="{{swiper}}" wx:key="index">
      <image class="swiper-img" src="{{item.image}}" mode="aspectFill" bindtap="goCategory"
        data-id="{{item.link}}" />
    </swiper-item>
  </swiper>

  <!-- 分类宫格 -->
  <view class="cate-grid" wx:if="{{categoryList.length}}">
    <view class="cate-item" wx:for="{{categoryList}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
      <image class="cate-icon" src="{{item.icon}}" mode="aspectFill" />
      <text class="cate-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 热门商品 -->
  <view class="section">
    <view class="section-title">
      <text>热门推荐</text>
      <text class="section-more" bindtap="goSearch">搜索商品 ›</text>
    </view>
    <view class="goods-grid">
      <view class="goods-card" wx:for="{{hotGoods}}" wx:key="id" bindtap="goGoods" data-id="{{item.id}}">
        <image class="thumb" src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="info">
          <view class="title">{{item.title}}</view>
          <view class="price-row">
            <view class="price"><text class="symbol">¥</text>{{item.price}}</view>
            <view class="origin-price" wx:if="{{item.originalPrice > item.price}}">¥{{item.originalPrice}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !hotGoods.length}}">暂无商品</view>
</view>
