.page {
  padding-bottom: 40rpx;
}

.swiper {
  width: 100%;
  height: 320rpx;
}

.swiper-img {
  width: 100%;
  height: 320rpx;
}

/* 分类宫格 */
.cate-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 24rpx 0 8rpx;
  margin-bottom: 16rpx;
}

.cate-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.cate-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.cate-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333;
}

/* 商品区 */
.section {
  background: #fff;
  padding-bottom: 8rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.section-more {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
}

.goods-grid .goods-card {
  width: calc(50% - 24rpx);
  margin: 12rpx;
  box-sizing: border-box;
}
