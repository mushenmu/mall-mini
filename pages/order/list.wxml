<view class="page">
  <!-- 状态 Tab -->
  <view class="tabs">
    <view class="tab {{activeTab === item.status ? 'active' : ''}}"
      wx:for="{{tabs}}" wx:key="status" bindtap="switchTab" data-status="{{item.status}}">
      {{item.label}}
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-card" wx:for="{{orders}}" wx:key="orderNo" bindtap="goDetail" data-no="{{item.orderNo}}">
    <view class="order-head">
      <text class="order-no">单号 {{item.orderNo}}</text>
      <text class="order-status status-{{item.status}}">{{item.statusLabel}}</text>
    </view>
    <view class="order-body">
      <image class="thumb" src="{{item.firstImage}}" mode="aspectFill" />
      <view class="order-info">
        <view class="title">{{item.title}}</view>
        <view class="meta">{{item.createTime}} · 共{{item.goodsCount}}件</view>
      </view>
    </view>
    <view class="order-foot">
      <text class="total-label">实付</text>
      <text class="price"><text class="symbol">¥</text>{{item.totalAmount}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !orders.length}}">暂无订单</view>
</view>
